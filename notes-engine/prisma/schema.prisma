// Prisma schema mirrors supabase/schema.sql (Supabase Postgres).
// Render runs `prisma migrate deploy` on every build, so the DB migrates itself.
// Runtime queries still use supabase-js (service_role); Prisma owns DDL only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooler :6543 (app traffic)
  directUrl = env("DIRECT_URL") // direct :5432 (migrations)
}

model University {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String    @unique
  shortName String?   @map("short_name")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  profiles  Profile[]

  @@map("universities")
}

model Profile {
  id            String      @id @db.Uuid // = auth.users.id
  firstName     String?     @map("first_name")
  email         String?
  university    String?
  faculty       String?
  department    String?
  level         String?
  semester      String?
  universityId  String?     @map("university_id") @db.Uuid
  universityRef University? @relation(fields: [universityId], references: [id])
  gradTarget    Decimal?    @map("grad_target") @db.Decimal
  role          String      @default("student")
  isAdmin       Boolean     @default(false) @map("is_admin")
  notifyNewNotes Boolean    @default(true) @map("notify_new_notes")
  emailConfirmed Boolean    @default(false) @map("email_confirmed")
  avatarUrl     String      @default("") @map("avatar_url")
  boxBoyPersona String?     @map("box_boy_persona") // Phase 2: go-getter | comeback | curious | team-player | on-the-move
  semesterStart DateTime?   @map("semester_start") @db.Date
  semesterWeeks Int?        @default(12) @map("semester_weeks")
  cgpaCurrent   Decimal?    @map("cgpa_current") @db.Decimal(3,2)
  cgpaTarget    Decimal?    @map("cgpa_target") @db.Decimal(3,2)
  hideCgpa      Boolean     @default(false) @map("hide_cgpa")
  cgpaUnitsDone  Int?       @map("cgpa_units_done")
  cgpaUnitsTotal Int?       @map("cgpa_units_total")
  degreeYears    Int?       @map("degree_years")
  attendanceFullName String? @map("attendance_full_name")
  attendanceMatric String? @map("attendance_matric")
  isHoc         Boolean     @default(false) @map("is_hoc")
  quietStart    String?     @map("quiet_start") // 0038: no push between quiet_start and quiet_end (Lagos, HH:MM)
  quietEnd      String?     @map("quiet_end")
  hocApprovedAt DateTime?   @map("hoc_approved_at") @db.Timestamptz(6)
  hocApprovedBy String?     @map("hoc_approved_by") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("profiles")
}

model Course {
  code      String   @id
  title     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  weeks     Week[]
  levels    CourseLevel[]
  topicNotes TopicNote[]

  @@map("courses")
}

model CourseLevel {
  course    String
  level     String
  semester  String   @default("First Semester")
  courseRef Course @relation(fields: [course], references: [code], onDelete: Cascade)

  @@id([course, level])
  @@map("course_levels")
}

model Week {
  course    String
  week      Int
  title     String   @default("")
  subtitle  String   @default("")
  noteJson  Json     @map("note_json")
  authorId  String?  @map("author_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  courseRef Course   @relation(fields: [course], references: [code], onDelete: Cascade)

  @@id([course, week])
  @@map("weeks")
}

model TopicProgress {
  userId      String    @map("user_id") @db.Uuid
  course      String
  week        Int
  topic       Int
  lectureNo   Int      @default(1) @map("lecture_no")
  done        Boolean   @default(true)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  @@id([userId, course, week, topic, lectureNo])
  @@map("topic_progress")
}

model XpEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  amount    Int
  reason    String   @default("")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt(sort: Desc)], map: "xp_events_user_created_idx")
  @@map("xp_events")
}

model AiModel {
  model     String   @id
  failures  Int      @default(0)
  lastOk    DateTime? @map("last_ok") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("ai_models")
}

model Enrollment {
  userId    String   @map("user_id") @db.Uuid
  course    String
  kind      String   @default("taking")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([userId, course])
  @@map("enrollments")
}

model CourseStatus {
  userId     String   @map("user_id") @db.Uuid
  courseCode String   @map("course_code")
  status     String   // done | priority | not_yet
  units      Int      @default(3)
  grade      Decimal? @db.Decimal(3,2)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([userId, courseCode])
  @@index([userId])
  @@index([userId, status])
  @@map("course_status")
}

model TopicNote {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  course    String
  week      Int
  topic     Int
  lectureNo Int      @default(1) @map("lecture_no")
  version   Int      @default(1)
  title     String   @default("")
  noteJson  Json     @map("note_json")
  authorId  String?  @map("author_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  courseRef Course   @relation(fields: [course], references: [code], onDelete: Cascade)

  @@unique([course, week, lectureNo, topic, version])
  @@index([course, week, topic, version(sort: Desc)], map: "topic_notes_lookup_idx")
  @@map("topic_notes")
}

model QuizAttempt {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  course    String
  week      Int
  score     Int
  total     Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt(sort: Desc)], map: "quiz_attempts_user_idx")
  @@map("quiz_attempts")
}

model AppSetting {
  key       String   @id
  value     String   @default("")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("app_settings")
}

model ResumeState {
  userId    String   @id @map("user_id") @db.Uuid
  course    String
  week      Int
  topic     Int      @default(0)
  lectureNo Int      @default(1) @map("lecture_no")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("resume_state")
}

model ClassSlot {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  course     String
  lecturerId String?  @map("lecturer_id") @db.Uuid // whoever added it; null once that account is deleted (0035)
  day        Int
  startTime  String   @map("start_time")
  endTime    String   @map("end_time")
  venue      String    @default("")
  meetLink   String    @default("") @map("meet_link")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([course, day, startTime])
  @@index([course, day, startTime], map: "class_slots_course_idx")
  @@index([lecturerId], map: "class_slots_lecturer_idx")
  @@map("class_slots")
}

model ClientError {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  kind       String   @default("client")
  message    String   @default("")
  stack      String   @default("")
  url        String   @default("")
  appVersion String   @default("") @map("app_version")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)], map: "client_errors_created_idx")
  @@map("client_errors")
}

model RoleRequest {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String
  level     String   @default("")
  courses   String[] @default([])
  status    String   @default("pending")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  decidedAt DateTime? @map("decided_at") @db.Timestamptz(6)

  @@index([status, createdAt(sort: Desc)], map: "role_requests_status_idx")
  @@index([userId], map: "role_requests_user_idx")
  @@map("role_requests")
}

model Notification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String   @default("new_note")
  title     String   @default("")
  body      String   @default("")
  course    String?
  week      Int?
  topic     Int?
  link      String?
  read      Boolean  @default(false)
  pinned    Boolean  @default(false) // 0037: important "From Unify" messages stay on top
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt(sort: Desc)], map: "notifications_user_idx")
  @@map("notifications")
}

model PushSubscription {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId], map: "push_subscriptions_user_idx")
  @@map("push_subscriptions")
}

model ShareLink {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token     String   @unique
  userId    String   @map("user_id") @db.Uuid
  course    String
  week      Int
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  views     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId], map: "share_links_user_idx")
  @@index([token], map: "share_links_token_idx")
  @@map("share_links")
}

model DeviceKey {
  userId      String   @id @map("user_id") @db.Uuid
  devicePubkey String  @map("device_pubkey")
  registeredAt DateTime @default(now()) @map("registered_at") @db.Timestamptz(6)

  @@map("device_keys")
}

model AttendanceRecord {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId  String?  @map("student_id") @db.Uuid // null: typed from the class list before the student joined
  courseCode String   @map("course_code")
  scannedBy  String?  @map("scanned_by") @db.Uuid // null once that account is deleted (0035)
  scannedAt  DateTime @default(now()) @map("scanned_at") @db.Timestamptz(6)
  verified   Boolean  @default(false)
  week       Int?
  sessionId  String?  @map("session_id") @db.Uuid
  method     String   @default("code") // scan (pass scanned) | typed (matric typed by HOC/lecturer) | code (online code)
  entryId    String?  @map("entry_id") @db.Uuid // class_list_entries.id

  @@index([studentId, courseCode])
  @@index([courseCode, scannedAt])
  @@map("attendance_records")
}

model HocPost {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authorId     String   @map("author_id") @db.Uuid
  department   String
  level        String
  type         String
  title        String?
  content      String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([department, level])
  @@map("hoc_posts")
}

model LecturerMaterial {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  uploadedBy String   @map("uploaded_by") @db.Uuid
  courseCode String   @map("course_code")
  weekNumber Int      @map("week_number")
  type       String
  fileUrl    String   @map("file_url")
  title      String   @default("")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([courseCode, weekNumber])
  @@map("lecturer_materials")
}

model OnlineClassSession {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseCode String  @map("course_code")
  meetLink  String?  @map("meet_link")
  startedAt DateTime? @map("started_at") @db.Timestamptz(6)
  endedAt   DateTime? @map("ended_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("online_class_sessions")
}

model OnlineCheckin {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId  String   @map("session_id") @db.Uuid
  studentId  String   @map("student_id") @db.Uuid
  checkin1   DateTime? @map("checkin_1") @db.Timestamptz(6)
  checkin2   DateTime? @map("checkin_2") @db.Timestamptz(6)
  checkin3   DateTime? @map("checkin_3") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([sessionId, studentId])
  @@map("online_checkins")
}

model AttendanceSession {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseCode String    @map("course_code")
  createdBy  String?   @map("created_by") @db.Uuid // null once that account is deleted (0035)
  code       String
  week       Int?
  opensAt    DateTime  @default(now()) @map("opens_at") @db.Timestamptz(6)
  closesAt   DateTime  @map("closes_at") @db.Timestamptz(6)
  closedAt   DateTime? @map("closed_at") @db.Timestamptz(6)
  slotId     String?   @map("slot_id") @db.Uuid // class_slots.id: which timetabled class this register is for
  label      String    @default("") // "Extra class", or the slot's day and time

  @@index([courseCode, opensAt(sort: Desc)])
  @@index([courseCode, week], map: "attendance_sessions_course_week_idx")
  @@map("attendance_sessions")
}

// 0038: student "report a problem" + lecturer "review this week" (one queue)
model ContentReport {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  course     String
  week       Int
  topic      String   @default("")
  kind       String   @default("problem") // problem | review
  reason     String   @default("")
  text       String
  status     String   @default("open") // open | resolved
  resolvedBy String?  @map("resolved_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([course, status, createdAt(sort: Desc)], map: "content_reports_course_idx")
  @@map("content_reports")
}

// 0038: a lecturer's post to everyone taking a course
model CoursePost {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authorId  String?  @map("author_id") @db.Uuid
  course    String
  type      String   @default("announcement") // announcement | tip | reminder
  title     String?
  content   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([course, createdAt(sort: Desc)], map: "course_posts_course_idx")
  @@map("course_posts")
}

// Scoped roles (0036): level_admin (approves class reps for a department + level),
// hod (department), dean (faculty). Reports to hod/dean are counts only.
model RoleGrant {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  role        String
  institution String   @default("LASU")
  faculty     String   @default("")
  department  String   @default("")
  level       String   @default("")
  grantedBy   String?  @map("granted_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([userId, role, institution, faculty, department, level], map: "role_grants_unique")
  @@index([role, institution, department, level], map: "role_grants_scope_idx")
  @@map("role_grants")
}

model HocRequest {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  institution String    @default("LASU")
  department  String
  level       String
  note        String    @default("")
  status      String    @default("pending")
  decidedBy   String?   @map("decided_by") @db.Uuid
  decidedAt   DateTime? @map("decided_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, department, level], map: "hoc_requests_scope_idx")
  @@map("hoc_requests")
}

// Class lists (0032). One list per class: institution + department + level.
model ClassList {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institution String   @default("LASU")
  department  String
  level       String
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([institution, department, level], map: "class_lists_class_key")
  @@map("class_lists")
}

model ClassListEntry {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listId        String    @map("list_id") @db.Uuid
  institution   String    @default("LASU")
  matric        String
  fullName      String    @map("full_name")
  studentId     String?   @map("student_id") @db.Uuid
  claimedAt     DateTime? @map("claimed_at") @db.Timestamptz(6)
  claimMethod   String?   @map("claim_method") // matric | email | hoc | auto
  verifiedEmail String?   @map("verified_email")
  removedAt     DateTime? @map("removed_at") @db.Timestamptz(6)
  addedBy       String?   @map("added_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([listId, matric], map: "class_list_entries_matric_key")
  @@index([institution, matric], map: "class_list_entries_matric_idx")
  @@map("class_list_entries")
}

model ClassListLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listId    String   @map("list_id") @db.Uuid
  entryId   String?  @map("entry_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  detail    Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([listId, createdAt(sort: Desc)], map: "class_list_log_list_idx")
  @@map("class_list_log")
}

model ClassListClaim {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listId        String    @map("list_id") @db.Uuid
  studentId     String    @map("student_id") @db.Uuid
  matric        String
  fullName      String    @default("") @map("full_name")
  reason        String // not_on_list | already_claimed
  verifiedEmail String?   @map("verified_email")
  note          String    @default("")
  status        String    @default("open") // open | approved | rejected
  resolvedBy    String?   @map("resolved_by") @db.Uuid
  resolvedAt    DateTime? @map("resolved_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([listId, status, createdAt(sort: Desc)], map: "class_list_claims_open_idx")
  @@map("class_list_claims")
}

model ClassClaimCode {
  studentId String   @id @map("student_id") @db.Uuid
  email     String
  matric    String
  codeHash  String   @map("code_hash")
  attempts  Int      @default(0)
  sentAt    DateTime @default(now()) @map("sent_at") @db.Timestamptz(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  @@map("class_claim_codes")
}
