// Prisma schema mirrors supabase/schema.sql (Supabase Postgres).
// Render runs `prisma migrate deploy` on every build, so the DB migrates itself.
// Runtime queries still use supabase-js (service_role); Prisma owns DDL only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooler :6543 (app traffic)
  directUrl = env("DIRECT_URL") // direct :5432 (migrations)
}

model University {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String    @unique
  shortName String?   @map("short_name")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  profiles  Profile[]

  @@map("universities")
}

model Profile {
  id            String      @id @db.Uuid // = auth.users.id
  firstName     String?     @map("first_name")
  email         String?
  university    String?
  faculty       String?
  department    String?
  level         String?
  semester      String?
  universityId  String?     @map("university_id") @db.Uuid
  universityRef University? @relation(fields: [universityId], references: [id])
  gradTarget    Decimal?    @map("grad_target") @db.Decimal
  role          String      @default("student")
  isAdmin       Boolean     @default(false) @map("is_admin")
  notifyNewNotes Boolean    @default(true) @map("notify_new_notes")
  emailConfirmed Boolean    @default(false) @map("email_confirmed")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("profiles")
}

model Course {
  code      String   @id
  title     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  weeks     Week[]
  levels    CourseLevel[]
  topicNotes TopicNote[]

  @@map("courses")
}

model CourseLevel {
  course    String
  level     String
  semester  String   @default("First Semester")
  courseRef Course @relation(fields: [course], references: [code], onDelete: Cascade)

  @@id([course, level])
  @@map("course_levels")
}

model Week {
  course    String
  week      Int
  title     String   @default("")
  subtitle  String   @default("")
  noteJson  Json     @map("note_json")
  authorId  String?  @map("author_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  courseRef Course   @relation(fields: [course], references: [code], onDelete: Cascade)

  @@id([course, week])
  @@map("weeks")
}

model TopicProgress {
  userId      String    @map("user_id") @db.Uuid
  course      String
  week        Int
  topic       Int
  lectureNo   Int      @default(1) @map("lecture_no")
  done        Boolean   @default(true)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  @@id([userId, course, week, topic, lectureNo])
  @@map("topic_progress")
}

model XpEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  amount    Int
  reason    String   @default("")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt(sort: Desc)], map: "xp_events_user_created_idx")
  @@map("xp_events")
}

model AiModel {
  model     String   @id
  failures  Int      @default(0)
  lastOk    DateTime? @map("last_ok") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("ai_models")
}

model Enrollment {
  userId    String   @map("user_id") @db.Uuid
  course    String
  kind      String   @default("taking")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([userId, course])
  @@map("enrollments")
}

model TopicNote {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  course    String
  week      Int
  topic     Int
  lectureNo Int      @default(1) @map("lecture_no")
  version   Int      @default(1)
  title     String   @default("")
  noteJson  Json     @map("note_json")
  authorId  String?  @map("author_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  courseRef Course   @relation(fields: [course], references: [code], onDelete: Cascade)

  @@unique([course, week, lectureNo, topic, version])
  @@index([course, week, topic, version(sort: Desc)], map: "topic_notes_lookup_idx")
  @@map("topic_notes")
}

model QuizAttempt {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  course    String
  week      Int
  score     Int
  total     Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt(sort: Desc)], map: "quiz_attempts_user_idx")
  @@map("quiz_attempts")
}

model AppSetting {
  key       String   @id
  value     String   @default("")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("app_settings")
}

model ResumeState {
  userId    String   @id @map("user_id") @db.Uuid
  course    String
  week      Int
  topic     Int      @default(0)
  lectureNo Int      @default(1) @map("lecture_no")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("resume_state")
}

model ClassSlot {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  course     String
  lecturerId String   @map("lecturer_id") @db.Uuid
  day        Int
  startTime  String   @map("start_time")
  endTime    String   @map("end_time")
  venue      String    @default("")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([course, day, startTime])
  @@index([course, day, startTime], map: "class_slots_course_idx")
  @@index([lecturerId], map: "class_slots_lecturer_idx")
  @@map("class_slots")
}

model ClientError {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  kind       String   @default("client")
  message    String   @default("")
  stack      String   @default("")
  url        String   @default("")
  appVersion String   @default("") @map("app_version")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)], map: "client_errors_created_idx")
  @@map("client_errors")
}

model Notification {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String   @default("new_note")
  title     String   @default("")
  body      String   @default("")
  course    String?
  week      Int?
  topic     Int?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt(sort: Desc)], map: "notifications_user_idx")
  @@map("notifications")
}

model PushSubscription {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId], map: "push_subscriptions_user_idx")
  @@map("push_subscriptions")
}

model ShareLink {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token     String   @unique
  userId    String   @map("user_id") @db.Uuid
  course    String
  week      Int
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  views     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId], map: "share_links_user_idx")
  @@index([token], map: "share_links_token_idx")
  @@map("share_links")
}
