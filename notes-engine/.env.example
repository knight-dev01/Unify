# Unify Notes Creation Engine Configuration
PORT=3000

# AI provider for /api/convert: 'gemini' (default, free tier) or 'anthropic'.
AI_PROVIDER=gemini

# Set your Anthropic API Key here (or enter it in the Web UI Anthropic API Key field)
ANTHROPIC_API_KEY=sk-ant-api03-YOUR_KEY_HERE

# ...or a Gemini key from Google AI Studio (used when AI_PROVIDER=gemini)
GEMINI_API_KEY=AIza_YOUR_KEY_HERE
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MODELS=gemini-2.0-flash,gemini-1.5-flash

# Supabase (backend uses service_role; client auth verify uses anon key)
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
SUPABASE_SECRET_KEY=sb_secret_YOUR_KEY

# Prisma -> Supabase Postgres (Settings > Database > connection strings).
# DATABASE_URL = pooler (port 6543, for the running app).
# DIRECT_URL = direct (port 5432, for prisma migrate deploy).
DATABASE_URL=postgresql://postgres.xyzcompany:[YOUR-DB-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.xyzcompany:[YOUR-DB-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# Comma-separated allowed web origins (Vercel URL). Empty = allow all (dev only).
CORS_ORIGIN=https://unify-virid.vercel.app

# Bootstrap platform admins until profiles are flagged directly.
ADMIN_EMAILS=you@example.com
